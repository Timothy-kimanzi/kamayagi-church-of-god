</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="brand brand-footer">
        <% if (s.logo) { %><img src="<%= u.mediaUrl(s.logo) %>" alt=""><% } else { %><span class="brand-mark">✝</span><% } %>
        <span class="brand-text"><%= s.churchName %></span>
      </div>
      <p><%= s.footerText %></p>
      <div class="socials">
        <% [['facebookUrl','Facebook'],['youtubeUrl','YouTube'],['instagramUrl','Instagram'],['tiktokUrl','TikTok'],['xUrl','X']].forEach(([k, label]) => { if (s[k]) { %>
          <a href="<%= s[k] %>" target="_blank" rel="noopener"><%= label %></a>
        <% } }) %>
      </div>
    </div>
    <div>
      <h4>Visit Us</h4>
      <p><%= s.address %></p>
      <p><a href="/services">See service times &rarr;</a></p>
    </div>
    <div>
      <h4>Contact</h4>
      <% if (s.phone) { %><p><a href="tel:<%= s.phone.replace(/\s/g, '') %>"><%= s.phone %></a></p><% } %>
      <% if (s.email) { %><p><a href="mailto:<%= s.email %>"><%= s.email %></a></p><% } %>
      <% if (s.officeHours) { %><p><%= s.officeHours %></p><% } %>
    </div>
    <div>
      <h4>Quick Links</h4>
      <p><a href="/live">Watch Live</a></p>
      <p><a href="/give">Give / Offering</a></p>
      <p><a href="/testimonies">Share a Testimony</a></p>
      <p><a href="/prayer">Prayer Request</a></p>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>&copy; <%= new Date().getFullYear() %> <%= s.churchName %>. All rights reserved.</span>
    <a href="/admin">Admin</a>
  </div>
</footer>
<% if (s.whatsapp) { %>
  <a class="whatsapp-float" href="https://wa.me/<%= s.whatsapp.replace(/\D/g, '') %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
  </a>
<% } %>
<script src="/js/main.js"></script>
</body>
</html>
