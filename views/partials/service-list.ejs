<div class="service-grid">
  <% services.forEach((sv) => { %>
    <div class="service-card">
      <div class="service-day"><%= sv.day %></div>
      <h3><%= sv.name %></h3>
      <div class="service-time"><%= u.formatTime(sv.startTime) %><%= sv.endTime ? ' – ' + u.formatTime(sv.endTime) : '' %></div>
      <% if (sv.description) { %><p><%= sv.description %></p><% } %>
    </div>
  <% }) %>
</div>
