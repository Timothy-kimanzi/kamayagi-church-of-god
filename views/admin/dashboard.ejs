<%- include('../partials/admin-header') %>
<h1>Welcome, <%= userName %></h1>
<p class="muted">Manage everything on the <%= s.churchName %> website from here. Changes show on the website immediately.</p>
<div class="quick">
  <% if (can('settings-live')) { %>
  <form method="post" action="/admin/settings/live" class="panel live-toggle">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% settingGroups.find((g) => g.id === 'live').fields.forEach((f) => { if (f.type !== 'checkbox') { %><input type="hidden" name="<%= f.name %>" value="<%= s[f.name] %>"><% } }) %>
    <% if (!s.isLive) { %><input type="hidden" name="isLive" value="on"><% } %>
    <div><strong>Live stream</strong><br><span class="muted"><%= s.isLive ? 'The live banner is ON.' : 'Not live right now.' %></span></div>
    <button class="btn <%= s.isLive ? 'btn-danger' : '' %>"><%= s.isLive ? 'End live' : 'Go live' %></button>
  </form>
  <a class="panel quick-link" href="/admin/settings/live">Set live stream links &rarr;</a>
  <% } %>
  <% if (can('sermons')) { %><a class="panel quick-link" href="/admin/r/sermons/new">+ Add sermon</a><% } %>
  <% if (can('events')) { %><a class="panel quick-link" href="/admin/r/events/new">+ Add event</a><% } %>
  <% if (can('gallery')) { %><a class="panel quick-link" href="/admin/r/gallery/new">+ Upload photo</a><% } %>
</div>
<div class="stats">
  <% Object.entries(resources).forEach(([k, r]) => { %>
    <a class="stat panel" href="/admin/r/<%= k %>"><strong><%= counts[k] %></strong><span><%= r.label %></span></a>
  <% }) %>
</div>
<% if (badges.testimonies) { %><div class="alert alert-info"><%= badges.testimonies %> testimon<%= badges.testimonies === 1 ? 'y is' : 'ies are' %> waiting for approval. <a href="/admin/r/testimonies">Review now</a></div><% } %>
<% if (badges.prayers) { %><div class="alert alert-info"><%= badges.prayers %> new prayer request<%= badges.prayers === 1 ? '' : 's' %>. <a href="/admin/prayers">Read now</a></div><% } %>
<% if (prayers) { %>
<div class="panel">
  <h2>Recent prayer requests</h2>
  <% if (prayers.length) { %>
    <table><tbody>
      <% prayers.forEach((m) => { %>
        <tr class="<%= m.read ? '' : 'unread' %>"><td><a href="/admin/prayers/<%= m._id %>"><%= m.name %></a></td><td><%= u.excerpt(m.message, 60) %></td><td><% if (m.prayed) { %><span class="pill on">Prayed for</span><% } %></td><td class="muted"><%= u.formatDate(m.createdAt) %></td></tr>
      <% }) %>
    </tbody></table>
    <p><a href="/admin/prayers">All prayer requests &rarr;</a></p>
  <% } else { %><p class="muted">No prayer requests yet.</p><% } %>
</div>
<% } %>
<% if (messages) { %>
<div class="panel">
  <h2>Recent messages</h2>
  <% if (messages.length) { %>
    <table><tbody>
      <% messages.forEach((m) => { %>
        <tr class="<%= m.read ? '' : 'unread' %>"><td><a href="/admin/messages/<%= m._id %>"><%= m.name %></a></td><td><%= m.subject %></td><td class="muted"><%= u.formatDate(m.createdAt) %></td></tr>
      <% }) %>
    </tbody></table>
  <% } else { %><p class="muted">No messages yet.</p><% } %>
</div>
<% } %>
<% if (!Object.keys(resources).length && !settingGroups.length && !messages && !prayers) { %><div class="alert alert-info">You have not been given access to any section yet. Ask the super admin to give you access.</div><% } %>
<%- include('../partials/admin-footer') %>
